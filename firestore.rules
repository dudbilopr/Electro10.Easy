rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de ayuda: Verifica si el usuario actual es el Admin
    function esAdmin() {
      // Reemplazar con el email real o la lógica de roles usada
      return request.auth != null && request.auth.token.email == "dudbilopr@gmail.com";
    }

    // Regla base del proyecto electro10 (APP_ID)
    match /artifacts/electro10/users/{userId} {
      
      // Permitir al usuario leer y escribir solo SUS PROPIOS datos
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Permitir al Administrador leer y modificar TODOS los usuarios
      allow read, write: if esAdmin();
      
      // Subcolecciones del usuario (estadísticas, progreso)
      match /stats/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if esAdmin();
      }
    }
    
    // Reglas adicionales para configuraciones generales o settings públicos
    match /artifacts/electro10/settings/{document=**} {
      allow read: if true; // Todos pueden leer configuración pública
      allow write: if esAdmin(); // Solo admin puede modificar
    }
    
  }
}
